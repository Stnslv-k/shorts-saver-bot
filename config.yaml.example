bot:
  token: "YOUR_TELEGRAM_BOT_TOKEN"
  password: "YOUR_SECRET_PASSWORD"

llm:
  backend: ollama       # ollama | openai | anthropic | openrouter
  fallback: openai      # optional — used if primary backend fails (for openrouter: used when all free models fail)

  ollama:
    url: "http://localhost:11434"
    model: "llama3.1:8b"

  openai:
    api_key: "YOUR_OPENAI_API_KEY"
    model: "gpt-4o-mini"

  anthropic:
    api_key: "YOUR_ANTHROPIC_API_KEY"
    model: "claude-haiku-4-5-20251001"

  # OpenRouter — tries free models first, then falls back to the backend above
  # Get a free API key at: https://openrouter.ai/settings/keys (no credit card required)
  # Free models are ranked daily by: https://shir-man.com/api/free-llm/top-models
  openrouter:
    api_key: "sk-or-YOUR_KEY"
    max_free_models: 3  # how many top free models to try before falling back

storage:
  backend: notion       # notion | obsidian

  notion:
    api_key: "YOUR_NOTION_INTEGRATION_TOKEN"
    database_id: "YOUR_NOTION_DATABASE_ID"

  obsidian:
    vault_path: "/path/to/your/vault/YouTube Shorts"

vision:
  enabled: false        # set to true to enable keyframe analysis
  backend: openai       # openai | anthropic

  openai:
    # Omit api_key to reuse llm.openai.api_key automatically
    api_key: "YOUR_OPENAI_API_KEY"
    model: "gpt-4o"

  anthropic:
    # Omit api_key to reuse llm.anthropic.api_key automatically
    api_key: "YOUR_ANTHROPIC_API_KEY"
    model: "claude-haiku-4-5-20251001"

search:
  enabled: true         # enable URL lookup for tools and GitHub projects
  backend: duckduckgo   # duckduckgo (default, no key needed) | brave

  brave:
    api_key: ""         # optional — set or use BRAVE_API_KEY env var
